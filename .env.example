# ─────────────────────────────────────────────────────────────
# Variables para despliegue con Docker (docker-compose lee este .env de la raíz)
# Para desarrollo local sin Docker, usa backend/.env en su lugar.
# Copia este archivo a .env y rellena los valores reales.
# ─────────────────────────────────────────────────────────────

# --- Notion ---
NOTION_TOKEN=ntn_tu_token_de_integracion
NOTION_DB_VENTAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_CLIENTES=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_INVENTARIO=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- App ---
PORT=3000
# En producción: la URL pública del servidor (para que el QR del PDF resuelva bien)
FRONTEND_URL=http://localhost

# --- Datos de pago que aparecen en el PDF ---
EMPRESA_BANCO=Banco General
EMPRESA_TIPO_CUENTA=Corriente
EMPRESA_CUENTA=04-88-888888-8
EMPRESA_CUENTA_NOMBRE=AgroTech Drones S.A.
EMPRESA_YAPPY=+507 6000-0000
